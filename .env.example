# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── Profile cache ─────────────────────────────────────────────────────────────
# Base64-encoded profile.cache.json — generated by: python -m src.main --rebuild-profile
# Leave empty for local development (agent reads profile.cache.json from disk instead)
PROFILE_CACHE=

# ── Companies config ──────────────────────────────────────────────────────────
# Base64-encoded config/companies.yaml — generated by: python -m src.main --sync-companies
# Required for company-direct monitoring in the cloud: config/companies.yaml is gitignored,
# so it never reaches the deployed container any other way. Leave empty for local development
# (agent reads config/companies.yaml from disk instead).
COMPANIES_CONFIG=

# ── Telegram ──────────────────────────────────────────────────────────────────
# Create a bot via @BotFather in Telegram to get a token (no business
# verification required). Message your bot once, then GET
# https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Adzuna ────────────────────────────────────────────────────────────────────
# Get from: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ── Wellfound ─────────────────────────────────────────────────────────────────
# Get from: https://wellfound.com/developers
WELLFOUND_API_KEY=

# ── SerpAPI (company discovery only) ─────────────────────────────────────────
# Used only to resolve unknown company career pages — not for job searching.
# Free tier: 100 searches/month. Get from: https://serpapi.com
SEARCH_API_KEY=

# ── JSearch (RapidAPI) ────────────────────────────────────────────────────────
# The only source that reaches LinkedIn postings (plus Glassdoor/ZipRecruiter) —
# every other source is free but doesn't cover LinkedIn. Metered per request on
# every plan; check your quota on the RapidAPI dashboard before raising the poll
# frequency (currently every 4 hours, ~180 calls/month, in main.py — sized for
# a 200/month free-tier plan). Leave empty to skip.
# Get a key by signing up on RapidAPI and subscribing to the "JSearch" API.
JSEARCH_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (local dev): sqlite:///./internship_agent.db
# Postgres (Railway):  postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./internship_agent.db

# ── Scheduler ─────────────────────────────────────────────────────────────────
RUN_INTERVAL_MINUTES=60    # How often to poll all sources (default: 60)

# ── Notifications ─────────────────────────────────────────────────────────────
# If matches in one cycle >= BURST_THRESHOLD, send one batched message instead of N individual ones
BURST_THRESHOLD=20

# ── Model overrides (optional) ────────────────────────────────────────────────
# Defaults shown. Haiku for scoring (fast/cheap), Sonnet for resume extraction (accuracy).
CLAUDE_SCORING_MODEL=claude-haiku-4-5-20251001
CLAUDE_EXTRACTION_MODEL=claude-sonnet-4-6
